import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
from datetime import datetime


class WeatherDiary:
    def __init__(self, root):
        self.root = root
        self.root.title("Weather Diary — Дневник погоды")
        self.root.geometry("800x600")

        # Файл для сохранения данных
        self.data_file = "weather_data.json"
        self.records = []

        self.load_records()
        self.setup_ui()
        self.refresh_record_list()

    def setup_ui(self):
        # Основной фрейм
        main_frame = ttk.Frame(self.root, padding="10")
        main_frame.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))

        # Фрейм добавления записи
        add_frame = ttk.LabelFrame(main_frame, text="Добавить запись о погоде", padding="10")
        add_frame.grid(row=0, column=0, columnspan=2, sticky=(tk.W, tk.E), pady=(0, 10))

        ttk.Label(add_frame, text="Дата (ДД.ММ.ГГГГ):").grid(row=0, column=0, sticky=tk.W)
        self.date_entry = ttk.Entry(add_frame, width=40)
        self.date_entry.grid(row=0, column=1, padx=(5, 0), sticky=(tk.W, tk.E))

        ttk.Label(add_frame, text="Температура (°C):").grid(row=1, column=0, sticky=tk.W, pady=(5, 0))
        self.temp_entry = ttk.Entry(add_frame, width=40)
        self.temp_entry.grid(row=1, column=1, padx=(5, 0), pady=(5, 0), sticky=(tk.W, tk.E))

        ttk.Label(add_frame, text="Описание погоды:").grid(row=2, column=0, sticky=tk.W, pady=(5, 0))
        self.desc_entry = ttk.Entry(add_frame, width=40)
        self.desc_entry.grid(row=2, column=1, padx=(5, 0), pady=(5, 0), sticky=(tk.W, tk.E))

        ttk.Label(add_frame, text="Осадки:").grid(row=3, column=0, sticky=tk.W, pady=(5, 0))
        self.precipitation_var = tk.StringVar(value="Нет")
        ttk.Combobox(add_frame, textvariable=self.precipitation_var,
                   values=["Да", "Нет"], width=15).grid(row=3, column=1,
                   padx=(5, 0), pady=(5, 0), sticky=tk.W)

        ttk.Button(add_frame, text="Добавить запись", command=self.add_record).grid(
            row=4, column=0, columnspan=2, pady=(10, 0))

        # Фрейм фильтрации
        filter_frame = ttk.LabelFrame(main_frame, text="Фильтрация", padding="10")
        filter_frame.grid(row=1, column=0, sticky=(tk.W, tk.E), pady=(0, 10))

        ttk.Label(filter_frame, text="Фильтр по дате (ДД.ММ.ГГГГ):").grid(row=0, column=0, sticky=tk.W)
        self.filter_date_var = ttk.Entry(filter_frame, width=20)
        self.filter_date_var.grid(row=0, column=1, padx=(5, 0), sticky=tk.W)

        ttk.Label(filter_frame, text="Температура > (°C):").grid(row=1, column=0, sticky=tk.W, pady=(5, 0))
        self.filter_temp_var = ttk.Entry(filter_frame, width=20)
        self.filter_temp_var.insert(0, "-50")
        self.filter_temp_var.grid(row=1, column=1, padx=(5, 0), pady=(5, 0), sticky=tk.W)

        ttk.Button(filter_frame, text="Применить фильтры", command=self.refresh_record_list).grid(
            row=2, column=0, columnspan=2, pady=(10, 0))

        # Фрейм списка записей
        list_frame = ttk.LabelFrame(main_frame, text="Записи о погоде", padding="10")
        list_frame.grid(row=2, column=0, columnspan=2, sticky=(tk.W, tk.E, tk.N, tk.S), pady=(0, 10))

        columns = ("ID", "Дата", "Температура", "Описание", "Осадки")
        self.record_tree = ttk.Treeview(list_frame, columns=columns, show="headings", height=15)

        for col in columns:
            self.record_tree.heading(col, text=col)
            self.record_tree.column(col, width=120)

        self.record_tree.grid(row=0, column=0, sticky=(tk.W, tk.E, tk.N, tk.S))

        scrollbar = ttk.Scrollbar(list_frame, orient=tk.VERTICAL, command=self.record_tree.yview)
        scrollbar.grid(row=0, column=1, sticky=(tk.N, tk.S))
        self.record_tree.configure(yscrollcommand=scrollbar.set)

        # Кнопки управления
        button_frame = ttk.Frame(main_frame)
        button_frame.grid(row=3, column=0, columnspan=2, pady=(0, 10))

        ttk.Button(button_frame, text="Удалить выбранную", command=self.delete_record).pack(side=tk.LEFT, padx=(0, 5))
        ttk.Button(button_frame, text="Сохранить в JSON", command=self.save_records).pack(side=tk.LEFT, padx=5)
        ttk.Button(button_frame, text="Загрузить из JSON", command=self.load_records_and_refresh).pack(side=tk.LEFT, padx=5)

    def validate_input(self):
        """Валидация ввода данных"""
        date_text = self.date_entry.get().strip()
        temp_text = self.temp_entry.get().strip()
        description = self.desc_entry.get().strip()

        if not date_text:
            messagebox.showerror("Ошибка", "Дата не может быть пустой!")
            return False
        try:
            date = datetime.strptime(date_text, "%d.%m.%Y")
        except ValueError:
            messagebox.showerror("Ошибка", "Неверный формат даты! Используйте ДД.ММ.ГГГГ")
            return False

        if not temp_text:
            messagebox.showerror("Ошибка", "Температура не может быть пустой!")
            return False
        try:
            temperature = float(temp_text)
        except ValueError:
            messagebox.showerror("Ошибка", "Температура должна быть числом!")
            return False

        if not description:
            messagebox.showerror("Ошибка", "Описание погоды не может быть пустым!")
            return False

        return True, date_text, temperature, description

    def add_record(self):
        validation_result = self.validate_input()
        if not validation_result:
            return

        is_valid, date_text, temperature, description = validation_result

        record = {
            "id": len(self.records) + 1,
            "date": date_text,
            "temperature": temperature,
            "description": description,
            "precipitation": self.precipitation_var.get()
        }

        self.records.append(record)
        self.refresh_record_list()
        self.clear_input_fields()

